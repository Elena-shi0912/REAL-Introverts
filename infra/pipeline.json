{
  "pipelineSpec": {
    "schemaVersion": "2.1.0",
    "sdkVersion": "1.37.0",
    "components": {
      "model_upload_task": {
        "executorLabel": "model_upload_executor",
        "inputDefinitions": {
          "parameters": {
            "model_path": {
              "parameterType": "STRING"
            },
            "display_name": {
              "parameterType": "STRING"
            },
            "project_id": {
              "parameterType": "STRING"
            },
            "location": {
              "parameterType": "STRING"
            }
          }
        }
      }
    },
    "deploymentSpec": {
      "executors": {
        "model_upload_executor": {
          "container": {
            "imageUri": "gcr.io/google-cloud-aiplatform/model-upload:latest",
            "command": [
              "python3",
              "-m",
              "google_cloud_pipeline_components.aiplatform.upload_model"
            ],
            "args": [
              "--model-path",
              "{{$.inputs.parameters['model_path']}}",
              "--display-name",
              "{{$.inputs.parameters['display_name']}}",
              "--project",
              "{{$.inputs.parameters['project_id']}}",
              "--location",
              "{{$.inputs.parameters['location']}}"
            ]
          }
        }
      }
    },
    "root": {
      "dag": {
        "tasks": {
          "model_upload_task": {
            "taskInfo": {
              "name": "model-upload"
            },
            "inputs": {
              "parameters": {
                "model_path": {
                  "runtimeValue": {
                    "constantValue": "gs://mbti_model_bucket/model"
                  }
                },
                "display_name": {
                  "runtimeValue": {
                    "constantValue": "mbti-uploaded-model"
                  }
                },
                "project_id": {
                  "runtimeValue": {
                    "constantValue": "winged-odyssey-477518-p0"
                  }
                },
                "location": {
                  "runtimeValue": {
                    "constantValue": "us"
                  }
                }
              }
            },
            "componentRef": {
              "name": "model_upload_task"
            }
          }
        }
      }
    }
  },
  "runtimeConfig": {
    "parameters": {
      "model_path": {
        "stringValue": "gs://mbti_model_bucket/model"
      },
      "display_name": {
        "stringValue": "mbti-uploaded-model"
      },
      "project_id": {
        "stringValue": "winged-odyssey-477518-p0"
      },
      "location": {
        "stringValue": "us"
      }
    }
  }
}
