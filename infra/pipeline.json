{
  "pipelineSpec": {
    "pipelineInfo": {
      "name": "train-deploy-pipeline",
      "description": "Pipeline that trains and deploys a scikit-learn model on Vertex AI."
    },
    "root": {
      "inputParameters": {
        "project_id": { "defaultValue": "winged-odyssey-477518-p0", "type": "STRING" },
        "pipeline_location": { "defaultValue": "us", "type": "STRING" }
      },
      "dag": {
        "tasks": {
          "train-model": {
            "taskInfo": {
              "name": "train-model"
            },
            "componentRef": {
              "name": "google-cloud-pipeline-components.aiplatform.CustomPythonPackageTrainingJobRunOp"
            },
            "inputs": {
              "parameters": {
                "project": { "runtimeValue": { "pipelineParameter": "project_id" } },
                "location": { "runtimeValue": { "pipelineParameter": "pipeline_location" } },
                "python_package_gcs_uri": { "runtimeValue": { "constantValue": "gs://mbti_model_bucket/trainer/trainer-0.1.tar.gz" } },
                "python_module_name": { "runtimeValue": { "constantValue": "trainer.task" } },
                "container_uri": { "runtimeValue": { "constantValue": "us-docker.pkg.dev/vertex-ai/training/scikit-learn-cpu.0-24:latest" } },
                "model_serving_container_image_uri": { "runtimeValue": { "constantValue": "us-docker.pkg.dev/vertex-ai/prediction/sklearn-cpu.0-24:latest" } }
              }
            },
            "outputs": {
              "artifacts": {
                "model": {
                  "artifactType": { "schemaTitle": "google.VertexModel" },
                  "metadata": {}
                }
              }
            }
          },
          "deploy-model": {
            "taskInfo": {
              "name": "deploy-model"
            },
            "componentRef": {
              "name": "google-cloud-pipeline-components.aiplatform.ModelDeployOp"
            },
            "inputs": {
              "artifacts": {
                "model": {
                  "taskOutputArtifact": {
                    "producerTask": "train-model",
                    "outputArtifactKey": "model"
                  }
                }
              },
              "parameters": {
                "endpoint_display_name": { "runtimeValue": { "constantValue": "real-introverts-endpoint" } },
                "project": { "runtimeValue": { "pipelineParameter": "project_id" } },
                "location": { "runtimeValue": { "pipelineParameter": "pipeline_location" } },
                "machine_type": { "runtimeValue": { "constantValue": "n1-standard-2" } }
              }
            }
          }
        }
      }
    }
  },
  "schemaVersion": "2.1.0"
}